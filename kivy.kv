            size_hint : (0.1,0.075)
            pos_hint : {'x' : 0.8, 'y' : 0.8}
            on_press : root.confirm()



<Setting_Color_Frame>

    canvas.before:
        
        Color:
            rgba : app.background_color

        Rectangle:
            pos  : self.pos
            size : self.size
    

    FloatLayout:
    
        Button:
            text : "Shortcuts"
            color : app.button_color
            font_size : self.width * 0.12
            size_hint : (0.1,0.075)
            pos_hint : {'x' : 0.3, 'y' : 0.8}
            on_press:

                root.manager.current = 'Settings_Shortcut'

        Button:
            text : "Home"
            color : app.button_color
            font_size : self.width * 0.12
            size_hint : (0.1,0.075)
            pos_hint : {'x' : 0.1, 'y' : 0.8}
            on_press:

                root.manager.current = 'Main_Page'
        

        Label:
            text : "Text Color"
            color : app.text_color
            font_size : self.width * 0.08
            size_hint : (0.4,0.2)
            pos_hint : {'x' : -0.06, 'y' : 0.5}

        Slider:
            value_track_color : (1,0,0,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.05, 'y' : 0.5}
            min : 0
            max : 1
            value : app.text_color[0]
            on_touch_move : root.set_text_theme(0, self.value)

        Slider:
            value_track_color : (0,1,0,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.05, 'y' : 0.4}
            min : 0
            max : 1
            value : app.text_color[1]
            on_touch_move : root.set_text_theme(1, self.value)

        Slider:
            value_track_color : (0,0,1,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.05, 'y' : 0.3}
            min : 0
            max : 1
            value : app.text_color[2]
            on_touch_move : root.set_text_theme(2, self.value)


        Label:
            text : "Background Color"
            color : app.text_color
            font_size : self.width * 0.08
            size_hint : (0.4,0.2)
            pos_hint : {'x' : 0.29, 'y' : 0.5}

        Slider:
            value_track_color : (1,0,0,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.35, 'y' : 0.5}
            min : 0
            max : 1
            value : app.background_color[0]
            on_touch_move : root.set_background_theme(0, self.value)

        Slider:
            value_track_color : (0,1,0,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.35, 'y' : 0.4}
            min : 0
            max : 1
            value : app.background_color[1]
            on_touch_move : root.set_background_theme(1, self.value)

        Slider:
            value_track_color : (0,0,1,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.35, 'y' : 0.3}
            min : 0
            max : 1
            value : app.background_color[2]
            on_touch_move : root.set_background_theme(2, self.value)


        Label:
            text : "Button Color"
            color : app.text_color
            font_size : self.width * 0.08
            size_hint : (0.4,0.2)
            pos_hint : {'x' : 0.55, 'y' : 0.5}

        Slider:
            value_track_color : (1,0,0,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.65, 'y' : 0.5}
            min : 0
            max : 1
            value : app.button_color[0]
            on_touch_move : root.set_button_theme(0, self.value)

        Slider:
            value_track_color : (0,1,0,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.65, 'y' : 0.4}
            min : 0
            max : 1
            value : app.button_color[1]
            on_touch_move : root.set_button_theme(1, self.value)



        Slider:
            value_track_color : (0,0,1,1)
            value_track : True
            orientation : "horizontal"
            size_hint : (0.3,0.075)
            pos_hint : {'x' : 0.65, 'y' : 0.3}
            min : 0
            max : 1
            value : app.button_color[2]
            on_touch_move : root.set_button_theme(2, self.value)


        Button:
            text : "Reset"
            color : app.button_color
            font_size : self.width * 0.12
            size_hint : (0.1,0.075) 
            pos_hint : {'x' : 0.8, 'y' : 0.8}
            on_press : 
                root.set_text_theme(0, 0)
                root.set_text_theme(1, 0)
                root.set_text_theme(2, 0)
                root.set_background_theme(0, 1)
                root.set_background_theme(1, 1)
                root.set_background_theme(2, 1)
                root.set_button_theme(0, 1)
                root.set_button_theme(1, 1)
                root.set_button_theme(2, 1)



<Overlay_Frame>
    
    canvas.before:

        Color:
            rgba : app.background_color

        Rectangle:
            pos  : self.pos
            size : self.size

    Button:
        text : app.shortcut_names[0]
        color : app.button_color
        font_size : self.width * 0.12
        size_hint : (0.3,0.2)
        pos_hint : {'x' : 0.35, 'y' : 0.6}
        on_press:
            root.button_function(1)

    Button:
        text : app.shortcut_names[1]
        color : app.button_color
        font_size : self.width * 0.12
        size_hint : (0.3,0.2)
        pos_hint : {'x' : 0.6, 'y' : 0.4}
        on_press:
            root.button_function(2)

    Button:
        text : app.shortcut_names[2]
        color : app.button_color
        font_size : self.width * 0.12
        size_hint : (0.3,0.2)
        pos_hint : {'x' : 0.35, 'y' : 0.2}
        on_press:
            root.button_function(3)

    Button:
        text : app.shortcut_names[3]
        color : app.button_color
        font_size : self.width * 0.12
        size_hint : (0.3,0.2)
        pos_hint : {'x' : 0.1, 'y' : 0.4}
        on_press:
            root.button_function(4)
